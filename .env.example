# Jenkins Server Configuration
# Rename this file to .env to use these settings
# Note: VS Code settings take precedence if configured

# Jenkins server URL
JENKINS_URL=http://your-jenkins-server:8080

# Authentication (optional — omit to run in read-only mode)
# When credentials are omitted, trigger-build and stop-build are disabled.
# The Jenkins server must allow anonymous read access for read-only mode to work.
JENKINS_USERNAME=your-username

# Option 1: Use password authentication
JENKINS_PASSWORD=your-password

# Option 2: Use API token authentication (recommended)
# JENKINS_TOKEN=your-api-token
